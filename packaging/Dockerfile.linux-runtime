# Node is only used to run the existing runtime smoke checks in this older libc environment.
FROM node:22-bullseye-slim AS node
FROM ubuntu:22.04

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        python3 libpython3.10 python3-pip binutils ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY requirements-build.txt /tmp/requirements-build.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-build.txt
