#!/usr/bin/env python3
"""hp — the Clippi-Health front door: get data in, rebuild, and query, with no SQL needed.

Getting data in
  ./hp doctor                           check prerequisites and the state of raw/, data/, dashboard
  ./hp setup                            one-time: create the local data folders
  ./hp add <file-or-folder …>           import an Apple Health export, a local email/document ZIP,
                                        PDFs, HTML, or a C-CDA record folder, then rebuild
  ./hp smart <arguments…>               connect directly with SMART-on-FHIR or import FHIR NDJSON
  ./hp build                            rebuild data/, dashboard.html and the reference documents from raw/
  ./hp open                             open dashboard.html in the default browser

Querying
  ./hp summary                          what is here: counts, coverage, sources
  ./hp sources                          where each record set came from, export dates, known gaps
  ./hp tests [filter]                   lab tests available (canonical name, group, n, first/last)
  ./hp labs <test> [--since DATE]       one test's full series; name is matched case-insensitively (regex allowed)
  ./hp search <words…> [--kind K] [--since DATE] [--limit N]
                                        full-text search; all words must match; "quoted phrase" and prefix* work
  ./hp show <id> [--full]               one record's text, metadata, file path and related records
  ./hp timeline [--lane L] [--since DATE]
  ./hp encounters [--dept D] [--since DATE]
  ./hp problems | meds | vitals [metric] [--since DATE]
  ./hp topic <name>                     the case-study section for a topic from topics.json
  ./hp sql "<select …>"                 read-only SQL
  ./hp schema                           the database schema (CREATE statements)
  --json on any command prints JSON instead of text.

Read data/DATA_DICTIONARY.md for what the tables mean. Nothing here interprets results.
"""
import argparse
import json
import re
import shutil
import sqlite3
import subprocess
import sys
import zipfile
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent
DB_PATH = ROOT / "data" / "health.db"
RAW = ROOT / "raw"
sys.path.insert(0, str(ROOT))
import reports  # noqa: E402
from archive_records import archive_kinds  # noqa: E402


def connect():
    if not DB_PATH.exists():
        sys.exit("data/health.db not found — run: ./hp build")
    return sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)


def run(cmd, **kw):
    """Run a subprocess, streaming its output; exit on failure."""
    print("$ " + " ".join(str(c) for c in cmd), flush=True)
    r = subprocess.run([str(c) for c in cmd], **kw)
    if r.returncode:
        sys.exit(f"command failed ({r.returncode})")
    return r


